    "description": "Colección oficial de endpoints para la Historia de Usuario: Consulta unificada de certificados de vigencia y antecedentes de contadores y sociedades, y el servicio REST de procesamiento MyJCC - Plataforma Nexura.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url_gateway",
