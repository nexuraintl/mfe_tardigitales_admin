{
  "name": "jcc-portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4300",
    "build": "ng build",
    "build:mfe": "ng build && node build-mfe.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "docker:build": "docker build -t mfe-tardigitales-admin .",
    "docker:run": "docker run -p 4300:80 mfe-tardigitales-admin",
    "docker:compose": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:rebuild": "docker-compose up -d --build"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/elements": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@types/qrcode": "^1.5.6",
    "angular-oauth2-oidc": "^22.0.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lit": "^3.3.3",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.0",
    "@angular/cli": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
